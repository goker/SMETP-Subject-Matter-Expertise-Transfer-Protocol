{
  "@context": {
    "@version": 1.1,
    "smetp": "https://ieataiforbreakfast.com/ns/smetp#",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "kg": "https://ieataiforbreakfast.com/kg/",

    "id": "@id",
    "type": "@type",

    "experts": { "@id": "smetp:hasExpert", "@container": "@set" },
    "sessions": { "@id": "smetp:hasSession", "@container": "@set" },
    "sources": { "@id": "smetp:hasSource", "@container": "@set" },
    "spans": { "@id": "smetp:hasSpan", "@container": "@set" },
    "concepts": { "@id": "smetp:hasConcept", "@container": "@set" },
    "claims": { "@id": "smetp:hasClaim", "@container": "@set" },
    "formulas": { "@id": "smetp:hasFormula", "@container": "@set" },
    "regulations": { "@id": "smetp:hasRegulation", "@container": "@set" },
    "workflows": { "@id": "smetp:hasWorkflow", "@container": "@set" },

    "name": "prov:label",
    "role": "smetp:role",
    "years_experience": { "@id": "smetp:yearsExperience", "@type": "xsd:integer" },

    "expert": { "@id": "prov:wasAssociatedWith", "@type": "@id" },
    "session": { "@id": "prov:wasGeneratedBy", "@type": "@id" },
    "method": { "@id": "smetp:method", "@container": "@set" },
    "date": { "@id": "prov:startedAtTime", "@type": "xsd:date" },
    "duration_min": { "@id": "smetp:durationMinutes", "@type": "xsd:integer" },

    "kind": "smetp:sourceKind",
    "title": "prov:label",
    "text": "smetp:text",
    "sha256": "smetp:textSha256",

    "source": { "@id": "smetp:spanOf", "@type": "@id" },
    "start": { "@id": "smetp:start", "@type": "xsd:nonNegativeInteger" },
    "end": { "@id": "smetp:end", "@type": "xsd:nonNegativeInteger" },
    "quote": "smetp:quote",

    "label": "skos:prefLabel",
    "alt_labels": { "@id": "skos:altLabel", "@container": "@set" },
    "notation": { "@id": "skos:notation", "@container": "@set" },
    "definition": "skos:definition",
    "broader": { "@id": "skos:broader", "@type": "@id", "@container": "@set" },
    "depends_on": { "@id": "smetp:dependsOn", "@type": "@id", "@container": "@set" },

    "statement": "smetp:statement",
    "condition": "smetp:condition",
    "value": { "@id": "smetp:value", "@type": "xsd:decimal" },
    "unit": "smetp:unit",
    "confidence": { "@id": "smetp:confidence", "@type": "xsd:decimal" },
    "status": { "@id": "smetp:status", "@type": "@vocab" },
    "about": { "@id": "smetp:about", "@type": "@id", "@container": "@set" },
    "evidence": { "@id": "smetp:evidencedBy", "@type": "@id", "@container": "@set" },
    "attributed_to": { "@id": "prov:wasAttributedTo", "@type": "@id" },
    "confirmed_by": { "@id": "smetp:confirmedBy", "@type": "@id", "@container": "@set" },
    "version": "smetp:version",
    "supersedes": { "@id": "smetp:supersedes", "@type": "@id" },
    "exception_to": { "@id": "smetp:exceptionTo", "@type": "@id", "@container": "@set" },
    "modifies": { "@id": "smetp:modifies", "@type": "@id", "@container": "@set" },
    "constrained_by": { "@id": "smetp:constrainedBy", "@type": "@id", "@container": "@set" },
    "conflicts_with": { "@id": "smetp:conflictsWith", "@type": "@id", "@container": "@set" },
    "contradicts": { "@id": "smetp:contradicts", "@type": "@id", "@container": "@set" },
    "review_note": "rdfs:comment",
    "visibility": "smetp:visibility",

    "expression": "smetp:expression",
    "computes": { "@id": "smetp:computes", "@type": "@id" },
    "uses": { "@id": "smetp:usesVariable", "@type": "@id", "@container": "@set" },

    "jurisdiction": "smetp:jurisdiction",
    "citation": "smetp:citation",
    "source_url": { "@id": "prov:atLocation", "@type": "@id" },
    "description": "rdfs:comment",

    "steps": { "@id": "smetp:hasStep", "@container": "@list" },
    "implements": { "@id": "smetp:implements", "@type": "@id", "@container": "@set" },
    "uses_formula": { "@id": "smetp:usesFormula", "@type": "@id" },

    "Expert": "smetp:Expert",
    "ElicitationSession": "smetp:ElicitationSession",
    "SourceDocument": "smetp:SourceDocument",
    "EvidenceSpan": "smetp:EvidenceSpan",
    "Concept": "smetp:Concept",
    "Rule": "smetp:Rule",
    "Threshold": "smetp:Threshold",
    "Heuristic": "smetp:Heuristic",
    "EdgeCase": "smetp:EdgeCase",
    "Definition": "smetp:Definition",
    "Exclusion": "smetp:Exclusion",
    "Formula": "smetp:Formula",
    "Regulation": "smetp:Regulation",
    "Workflow": "smetp:Workflow",
    "Step": "smetp:Step",

    "extracted": "smetp:extracted",
    "sme_confirmed": "smetp:sme_confirmed",
    "validated": "smetp:validated",
    "blocked": "smetp:blocked",
    "deprecated": "smetp:deprecated"
  }
}
